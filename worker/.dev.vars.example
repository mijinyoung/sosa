# 실제 값은 .dev.vars 또는 Cloudflare Worker Secrets에만 설정합니다. 이 파일을 복사해 사용하세요.
ALLOWED_ORIGIN=https://YOUR-LANDING-DOMAIN.example.com
APPS_SCRIPT_URL=https://script.google.com/macros/s/YOUR_DEPLOYMENT_ID/exec
APPS_SCRIPT_RELAY_TOKEN=replace-with-a-long-random-secret
META_PIXEL_ID=YOUR_PIXEL_ID
META_CAPI_ACCESS_TOKEN=YOUR_META_CAPI_ACCESS_TOKEN
# 개발용 Meta Test Events Code가 있을 때만 설정
META_TEST_EVENT_CODE=
